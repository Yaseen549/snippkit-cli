{
  "name": "@snippkit/cli",
  "version": "2.0.3",
  "description": "Official CLI for SnippKit",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "snix": "bin/snix.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "snippkit",
    "developer-tools"
  ],
  "author": "SnippKit",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "commander": "^11.1.0",
    "conf": "^10.2.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "pkg": "^5.8.1",
    "vitest": "^1.0.0"
  },
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build",
    "package": "npm run build && pkg dist/snix.cjs --name snix --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path ./executables"
  }
}